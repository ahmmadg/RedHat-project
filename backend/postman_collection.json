{
  "info": {
    "_postman_id": "trackflow-api-collection-vfinal",
    "name": "TrackFlow - Package Tracking System API (Final Submission)",
    "description": "Comprehensive Postman collection for TrackFlow package tracking system covering all 10 features for Customer, Courier, and Admin roles.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4000",
      "type": "string"
    },
    {
      "key": "customerToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "adminToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "courierToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "orderId",
      "value": "",
      "type": "string"
    },
    {
      "key": "trackingNumber",
      "value": "",
      "type": "string"
    },
    {
      "key": "courierId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Authentication (Member 1 - Features #1 & #2)",
      "item": [
        {
          "name": "Feature #1 - Register Customer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Ahmed Merchant\",\n  \"email\": \"ahmed.merchant@example.com\",\n  \"phone\": \"01012345678\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register"]
            }
          }
        },
        {
          "name": "Feature #2 - Login Customer",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const response = pm.response.json();",
                  "if (response.data && response.data.token) {",
                  "    pm.collectionVariables.set('customerToken', response.data.token);",
                  "    console.log('Customer token saved to collection variable');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"customer@trackflow.com\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "Feature #2 - Login Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const response = pm.response.json();",
                  "if (response.data && response.data.token) {",
                  "    pm.collectionVariables.set('adminToken', response.data.token);",
                  "    console.log('Admin token saved to collection variable');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@trackflow.com\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "Feature #2 - Login Courier",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const response = pm.response.json();",
                  "if (response.data && response.data.token) {",
                  "    pm.collectionVariables.set('courierToken', response.data.token);",
                  "    console.log('Courier token saved to collection variable');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"courier@trackflow.com\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "Verify Token Auth (Health)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{customerToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/test-auth",
              "host": ["{{baseUrl}}"],
              "path": ["api", "test-auth"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Customer Orders (Member 2 - Features #4, #5 & #6)",
      "item": [
        {
          "name": "Feature #4 - Create Order",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const response = pm.response.json();",
                  "if (response.data && response.data.id) {",
                  "    pm.collectionVariables.set('orderId', response.data.id);",
                  "    pm.collectionVariables.set('trackingNumber', response.data.trackingNumber);",
                  "    console.log('Order created: ' + response.data.trackingNumber);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{customerToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pickupLocation\": \"14 Abbas El Akkad, Nasr City, Cairo\",\n  \"dropoffLocation\": \"Villa 22, Road 9, Maadi, Cairo\",\n  \"packageDetails\": \"2x Cotton Shirts, Fragile Box, COD: EGP 450\",\n  \"deliveryTime\": \"2026-11-20T15:30:00.000Z\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/orders",
              "host": ["{{baseUrl}}"],
              "path": ["api", "orders"]
            }
          }
        },
        {
          "name": "Feature #5 - Get My Orders",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{customerToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/orders/my-orders",
              "host": ["{{baseUrl}}"],
              "path": ["api", "orders", "my-orders"]
            }
          }
        },
        {
          "name": "Feature #6 - Track Order by Tracking Number",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/orders/track/{{trackingNumber}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "orders", "track", "{{trackingNumber}}"]
            }
          }
        },
        {
          "name": "Feature #6 - Get Order Details by ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{customerToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/orders/{{orderId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "orders", "{{orderId}}"]
            }
          }
        },
        {
          "name": "Feature #6 - Cancel Pending Order",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{customerToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/orders/{{orderId}}/cancel",
              "host": ["{{baseUrl}}"],
              "path": ["api", "orders", "{{orderId}}", "cancel"]
            }
          }
        }
      ]
    },
    {
      "name": "3. Admin Management (Member 4 - Features #9 & #10)",
      "item": [
        {
          "name": "Feature #9 - Get All Orders",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/orders",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "orders"]
            }
          }
        },
        {
          "name": "Feature #10 - Get All Couriers",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const response = pm.response.json();",
                  "if (response.data && response.data.length > 0) {",
                  "    pm.collectionVariables.set('courierId', response.data[0].id);",
                  "    console.log('Captured Courier ID: ' + response.data[0].id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/couriers",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "couriers"]
            }
          }
        },
        {
          "name": "Feature #10 - Assign Courier to Order",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"courierId\": \"{{courierId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/orders/{{orderId}}/assign",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "orders", "{{orderId}}", "assign"]
            }
          }
        },
        {
          "name": "Feature #9 - Update Order Status (Admin)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"IN_TRANSIT\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/orders/{{orderId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "orders", "{{orderId}}"]
            }
          }
        },
        {
          "name": "Feature #9 - Delete Order (Admin)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/orders/{{orderId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "orders", "{{orderId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "4. Courier Operations (Members 3 & 4 - Features #7 & #8)",
      "item": [
        {
          "name": "Feature #7 - Get Assigned Orders",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{courierToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/courier/orders",
              "host": ["{{baseUrl}}"],
              "path": ["api", "courier", "orders"]
            }
          }
        },
        {
          "name": "Feature #7 - Accept Assigned Order",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{courierToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/courier/orders/{{orderId}}/accept",
              "host": ["{{baseUrl}}"],
              "path": ["api", "courier", "orders", "{{orderId}}", "accept"]
            }
          }
        },
        {
          "name": "Feature #7 - Decline Assigned Order",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{courierToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/courier/orders/{{orderId}}/decline",
              "host": ["{{baseUrl}}"],
              "path": ["api", "courier", "orders", "{{orderId}}", "decline"]
            }
          }
        },
        {
          "name": "Feature #8 - Mark Picked Up",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{courierToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"PICKED_UP\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/courier/orders/{{orderId}}/status",
              "host": ["{{baseUrl}}"],
              "path": ["api", "courier", "orders", "{{orderId}}", "status"]
            }
          }
        },
        {
          "name": "Feature #8 - Mark In Transit",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{courierToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"IN_TRANSIT\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/courier/orders/{{orderId}}/status",
              "host": ["{{baseUrl}}"],
              "path": ["api", "courier", "orders", "{{orderId}}", "status"]
            }
          }
        },
        {
          "name": "Feature #8 - Mark Delivered",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{courierToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"DELIVERED\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/courier/orders/{{orderId}}/status",
              "host": ["{{baseUrl}}"],
              "path": ["api", "courier", "orders", "{{orderId}}", "status"]
            }
          }
        }
      ]
    }
  ]
}
