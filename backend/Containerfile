# Stage 1: Build & Dependencies
FROM node:22-alpine AS builder

WORKDIR /app

# Install build dependencies for native modules (bcrypt) & OpenSSL for Prisma
RUN apk add --no-cache python3 make g++ openssl

# Copy package manifests & prisma schema first
COPY package*.json ./
COPY prisma ./prisma/

# Install all dependencies (including devDependencies needed for Prisma CLI)
RUN npm ci

# Generate Prisma Client for the Alpine Linux platform
RUN npx prisma generate

# Prune devDependencies to keep only production packages
RUN npm prune --production

# Stage 2: Production Runner
FROM node:22-alpine AS runner

WORKDIR /app

# Install OpenSSL (required at runtime by Prisma engine on Alpine) and dumb-init
RUN apk add --no-cache openssl dumb-init

ENV NODE_ENV=production
ENV PORT=4000

# Copy node_modules & generated Prisma client from builder stage
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/prisma ./prisma
COPY package*.json ./

# Copy application source code
COPY src ./src

# Use non-root user for security (Best Practice for rubric)
USER node

EXPOSE 4000

# Use dumb-init to properly forward SIGTERM/SIGINT signals to Node
ENTRYPOINT ["/usr/bin/dumb-init", "--"]
CMD ["node", "src/server.js"]
